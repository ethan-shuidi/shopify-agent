# Feishu custom app credentials
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Leave empty when Feishu event subscription uses long connection mode.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Water Pipe uses the OpenAI-compatible Chat Completions API.
AGENT_MODEL=openai-chat:claude-sonnet-4.6
OPENAI_BASE_URL=https://agent-api.shuiditech.com/api/v1
OPENAI_API_KEY=
WATER_PIPE_TITLE=feishu-shopify-agent

# Runtime settings
DATABASE_PATH=data/agent.db
MEMORY_MESSAGE_LIMIT=12
AGENT_MAX_WORKERS=4
LOG_LEVEL=INFO

# GA4 properties
GA4_PROPERTY_US=544454580
GA4_PROPERTY_JP=549454928
GA4_PROPERTY_EU=554019883
GA4_TOKEN_PATH=data/ga4-token.json
GA4_OAUTH_CLIENT_PATH=data/ga4-oauth-client.json

# Shopify
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Klaviyo
KLAVIYO_API_KEY_US=
KLAVIYO_API_KEY_JP=
KLAVIYO_API_KEY_EU=

# Code repository Q&A — set CODE_REPO_PATH to enable code-aware answers.
CODE_REPO_PATH=
CODE_REPO_FILE_EXTENSIONS=.py,.js,.ts,.jsx,.tsx,.liquid,.json,.html,.css,.scss,.yml,.yaml,.toml,.md,.txt,.graphql,.env.example
